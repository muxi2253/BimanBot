<mujoco model="sorting_scene">
  <compiler angle="radian" meshdir="." />
  <!-- The public scene always includes the public, primitive-geometry robot.
       Private deployments can point the Python loaders at another scene; the
       IK layer reads joint/TCP names from robot_config.yaml. -->
  <include file="../robot/dual_arm_robot.xml"/>
  <!-- <include file="objects/chouzhi.xml"/> -->
  <include file="objects/kebike.xml"/>
  <include file="objects/bluecup.xml"/>
  <!-- <include file="objects/qie.xml"/> -->

  <asset>
    <mesh name="crate_mesh" file="../assets/obj/crate.obj" scale="1.0 1.0 1.0" />
    <texture name="tex_crate" type="2d" file="../assets/obj/textures/plastic_crate_02_diff_4k.png" />
    <material name="mat_crate_source" texture="tex_crate" specular="0.35" shininess="0.2"
      reflectance="0.0" rgba="0.62 0.84 1.0 1.0" />
    <material name="mat_crate_target" texture="tex_crate" specular="0.35" shininess="0.2"
      reflectance="0.0" rgba="1.0 0.72 0.42 1.0" />
  </asset>

  <worldbody>
    <!-- Grasp anchor for the public demo: mocap body driven each step to track
         left_tcp's actual world pose while "carrying" an object; the weld below is
         retargeted at runtime (model.eq_obj2id) to whichever item is currently grasped. -->
    <body name="left_gripper_mocap" mocap="true" pos="0 0 1.5">
      <geom type="sphere" size="0.01" rgba="1 0 1 0.5" contype="0" conaffinity="0"/>
    </body>

    <!-- Destination table: robot chassis front edge is at x~0.335, this starts at x=0.95 -->
    <!-- 0.55 m work surface: comfortably below the robot's 0.80 m shoulders. -->
    <geom name="sort_table_top" type="box" size="0.25 0.70 0.025" pos="1.20 0 0.525" rgba="0.34 0.20 0.11 0.92" friction="1.0 0.005 0.0001" />
    <geom name="sort_table_leg_fl" type="box" size="0.02 0.02 0.25" pos="0.98 0.55 0.25" rgba="0.18 0.11 0.07 0.9" />
    <geom name="sort_table_leg_fr" type="box" size="0.02 0.02 0.25" pos="0.98 -0.55 0.25" rgba="0.18 0.11 0.07 0.9" />
    <geom name="sort_table_leg_bl" type="box" size="0.02 0.02 0.25" pos="1.42 0.55 0.25" rgba="0.18 0.11 0.07 0.9" />
    <geom name="sort_table_leg_br" type="box" size="0.02 0.02 0.25" pos="1.42 -0.55 0.25" rgba="0.18 0.11 0.07 0.9" />


    <!-- Destination crate: right-arm side (-Y), the only destination bin now (was crate_1+crate_2;
         crate_1's left-side slot is where the source bin sits now, see crate_0 below). Static
         (no freejoint) so the robot always has a fixed sorting target. -->
    <body name="crate_2" pos="1.20 -0.35 0.57" quat="1 1 0 0">
      <geom name="crate_2_visual" type="mesh" mesh="crate_mesh" material="mat_crate_target"
        contype="0" conaffinity="0" density="0" />
      <!-- Four 20 mm feet put the visual basket clearly on the tabletop. -->
      <geom name="crate_2_foot_1" type="box" pos="-0.21 -0.01 -0.16" size="0.018 0.01 0.018"
        material="mat_crate_target" contype="0" conaffinity="0" mass="0" />
      <geom name="crate_2_foot_2" type="box" pos="0.21 -0.01 -0.16" size="0.018 0.01 0.018"
        material="mat_crate_target" contype="0" conaffinity="0" mass="0" />
      <geom name="crate_2_foot_3" type="box" pos="-0.21 -0.01 0.16" size="0.018 0.01 0.018"
        material="mat_crate_target" contype="0" conaffinity="0" mass="0" />
      <geom name="crate_2_foot_4" type="box" pos="0.21 -0.01 0.16" size="0.018 0.01 0.018"
        material="mat_crate_target" contype="0" conaffinity="0" mass="0" />
      <geom name="crate_2_proxy_bottom" type="box" size="0.2528 0.006 0.2028"
        pos="0.0 0.006 0.0000" density="400" friction="1.2 0.01 0.001" rgba="1 0 0 0" />
      <geom name="crate_2_proxy_wall_xneg" type="box" size="0.0075 0.1270 0.2028"
        pos="-0.245 0.12 0.0" density="400" friction="1.2 0.01 0.001" rgba="1 0 0 0" />
      <geom name="crate_2_proxy_wall_xpos" type="box" size="0.0075 0.1270 0.2028"
        pos="0.245 0.12 0.0000" density="400" friction="1.2 0.01 0.001" rgba="1 0 0 0" />
      <geom name="crate_2_proxy_wall_zneg" type="box" size="0.2528 0.1270 0.0075"
        pos="0.0 0.125 -0.19" density="400" friction="1.2 0.01 0.001" rgba="1 0 0 0" />
      <geom name="crate_2_proxy_wall_zpos" type="box" size="0.2528 0.1270 0.0075"
        pos="0.0 0.12 0.19" density="400" friction="1.2 0.01 0.001" rgba="1 0 0 0" />
    </body>

    <!-- Source bin: repurposed crate_0, holds the loose SKU items for the robot to pick from.
         Sits on the table's left side (+Y, where crate_1 used to be) so picking (left) and
         sorting into crate_2 (right) both happen on the tabletop. Static (no freejoint) so
         freefall items cannot push the bin off its position. -->
    <body name="crate_0" pos="1.20 0.35 0.57" quat="1 1 0 0">
      <geom name="crate_0_visual" type="mesh" mesh="crate_mesh" material="mat_crate_source"
        contype="0" conaffinity="0" density="0" />
      <geom name="crate_0_foot_1" type="box" pos="-0.21 -0.01 -0.16" size="0.018 0.01 0.018"
        material="mat_crate_source" contype="0" conaffinity="0" mass="0" />
      <geom name="crate_0_foot_2" type="box" pos="0.21 -0.01 -0.16" size="0.018 0.01 0.018"
        material="mat_crate_source" contype="0" conaffinity="0" mass="0" />
      <geom name="crate_0_foot_3" type="box" pos="-0.21 -0.01 0.16" size="0.018 0.01 0.018"
        material="mat_crate_source" contype="0" conaffinity="0" mass="0" />
      <geom name="crate_0_foot_4" type="box" pos="0.21 -0.01 0.16" size="0.018 0.01 0.018"
        material="mat_crate_source" contype="0" conaffinity="0" mass="0" />
      <geom name="crate_0_proxy_bottom" type="box" size="0.2528 0.006 0.2028"
        pos="0.0 0.006 0.0000" density="400" friction="1.2 0.01 0.001" rgba="1 0 0 0" />
      <geom name="crate_0_proxy_wall_xneg" type="box" size="0.0075 0.1270 0.2028"
        pos="-0.245 0.12 0.0" density="400" friction="1.2 0.01 0.001" rgba="1 0 0 0" />
      <geom name="crate_0_proxy_wall_xpos" type="box" size="0.0075 0.1270 0.2028"
        pos="0.245 0.12 0.0000" density="400" friction="1.2 0.01 0.001" rgba="1 0 0 0" />
      <geom name="crate_0_proxy_wall_zneg" type="box" size="0.2528 0.1270 0.0075"
        pos="0.0 0.125 -0.19" density="400" friction="1.2 0.01 0.001" rgba="1 0 0 0" />
      <geom name="crate_0_proxy_wall_zpos" type="box" size="0.2528 0.1270 0.0075"
        pos="0.0 0.12 0.19" density="400" friction="1.2 0.01 0.001" rgba="1 0 0 0" />
    </body>

    <!-- 4 loose SKU items in crate_0. Proxies auto-derived from derive_proxy_from_mesh.py. -->
  </worldbody>

  <equality>
    <!-- Kinematic grasp for public_demo.py: body2 is a placeholder, retargeted at runtime
         via model.eq_obj2id to whichever item is currently held; eq_data (relative pose)
         must be overwritten with the current relative pose right before activation, or
         MuJoCo snaps the object to this XML-authored default offset instead (verified).
         Deliberately NOT using a stiffer solref/solimp here: a tighter constraint reduces
         steady-state sag but overshoots violently (multi-meter launch, observed) when
         correcting anything but a tiny initial error — default softness converges smoothly
         over ~100-400 steps instead, which matters more than sag for this use case. -->
    <weld name="left_grasp_weld" body1="left_gripper_mocap" active="false"/>
  </equality>
</mujoco>
